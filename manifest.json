{
    "manifest_version": 2,
    "name": "Tabfree",
    "description": "Converts tabs to windows and syncs X11 window icons.",
    "version": "0.5",
    "developer": {
        "name": "Arnaud Bétrémieux",
        "url": "https://github.com/arnoo/tabfree"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "tabfree@arnoo.github.com",
            "strict_min_version": "58.0"
        }
    },
    "background": {
        "scripts": [
            "background.js"
        ]
    },
    "permissions": [
        "nativeMessaging",
        "tabs",
        "webNavigation"
    ]
}
